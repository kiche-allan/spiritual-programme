{
  "name": "spiritual-programme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "prebuild": "node scripts/build-content.js && node scripts/build-blog.js",
    "start": "next start",
    "content": "node scripts/build-content.js",
    "blog": "node scripts/build-blog.js",
    "validate-content": "node scripts/validate-content.js",
    "generate-tree": "node scripts/generate-tree.js > project-structure.txt",
    "test": "jest",
    "test:unit": "jest --testPathPattern='__tests__/unit' --coverage",
    "test:integration": "jest --testPathPattern='__tests__/integration'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:perf": "k6 run __tests__/performance/load.js",
    "test:perf:ci": "k6 run --env BASE_URL=$BASE_URL __tests__/performance/load.js",
    "test:security:snyk": "snyk test --severity-threshold=high",
    "test:security:zap": "bash __tests__/security/owasp-zap.sh",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "report:coverage": "open coverage/lcov-report/index.html || xdg-open coverage/lcov-report/index.html"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/supabase-js": "latest",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "latest",
    "lucide-react": "^1.46.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^7.2.0",
    "allure-commandline": "^2.40.0",
    "allure-jest": "^3.7.2",
    "allure-playwright": "^3.7.2",
    "autoprefixer": "^10.0.1",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "snyk": "^1.1304.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "form-data": "4.0.6",
    "js-yaml": "3.15.2",
    "serialize-javascript": "7.0.3",
    "ws": "8.21.0"
  }
}

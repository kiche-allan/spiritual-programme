NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose to the client

# Optional "Save my progress" accounts. Google sign-in is always offered once the
# Google provider is enabled in Supabase. Email magic links are off by default
# because Supabase's built-in email is heavily rate-limited.
NEXT_PUBLIC_ENABLE_EMAIL_LINK=false

# Required by the email subscription and daily-email routes.
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Required for Axiom logging/web vitals (next-axiom). Create a dataset and
# API token at https://app.axiom.co, or install the Axiom integration from
# the Vercel Integrations dashboard to have these auto-populated.
NEXT_PUBLIC_AXIOM_DATASET=
NEXT_PUBLIC_AXIOM_TOKEN=

# Sentry error monitoring. DSN: Project Settings > Client Keys (DSN) in Sentry.
# The auth token (org "cmu-5k") is only needed at build time to upload source maps;
# create one under Settings > Developer Settings > Organization Tokens.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

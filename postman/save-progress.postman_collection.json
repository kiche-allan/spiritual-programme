{
  "info": {
    "name": "Walking With God - Save my progress",
    "description": "Checks the optional account endpoints. Set `baseUrl` (default https://spiritual-programme.vercel.app) and, for the authenticated request, `accessToken` (a Supabase user access token).\n\nRun with newman:\n  npx newman run postman/save-progress.postman_collection.json --env-var baseUrl=https://spiritual-programme.vercel.app --env-var accessToken=<token>\n\nThe valid-body request needs accessToken; without it that one request fails by design.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://spiritual-programme.vercel.app" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Sync with empty body returns 400",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/api/progress/sync", "host": ["{{baseUrl}}"], "path": ["api", "progress", "sync"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('never a 500', function () { pm.expect(pm.response.code).to.be.below(500); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Sync signed out returns 401",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"items\": [{ \"week\": 1, \"day\": 1 }] }" },
        "url": { "raw": "{{baseUrl}}/api/progress/sync", "host": ["{{baseUrl}}"], "path": ["api", "progress", "sync"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
              "pm.test('error message present', function () { pm.expect(pm.response.json()).to.have.property('error'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Sync valid body with bearer token returns merged items",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"items\": [{ \"week\": 1, \"day\": 1 }, { \"week\": 1, \"day\": 2 }] }" },
        "url": { "raw": "{{baseUrl}}/api/progress/sync", "host": ["{{baseUrl}}"], "path": ["api", "progress", "sync"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('items is a merged array containing the pushed days', function () {",
              "  const items = pm.response.json().items;",
              "  pm.expect(items).to.be.an('array');",
              "  const keys = items.map(function (i) { return i.week + ':' + i.day; });",
              "  pm.expect(keys).to.include.members(['1:1', '1:2']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete account signed out returns 401",
      "request": {
        "auth": { "type": "noauth" },
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/account", "host": ["{{baseUrl}}"], "path": ["api", "account"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    }
  ]
}

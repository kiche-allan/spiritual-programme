NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required by the email subscription and daily-email routes.
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Required for Axiom logging/web vitals (next-axiom). Create a dataset and
# API token at https://app.axiom.co, or install the Axiom integration from
# the Vercel Integrations dashboard to have these auto-populated.
NEXT_PUBLIC_AXIOM_DATASET=
NEXT_PUBLIC_AXIOM_TOKEN=
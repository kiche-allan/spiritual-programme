{
  "info": {
    "name": "Walking With God API",
    "description": "Smoke/contract checks for app/api/* routes. Run by newman in .github/workflows/staging-e2e.yml against the preview URL. Variables: baseUrl, bypassSecret (optional, Vercel deployment protection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const bypass = pm.variables.get('bypassSecret');",
          "if (bypass) pm.request.headers.upsert({ key: 'x-vercel-protection-bypass', value: bypass });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bypassSecret",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "subscribe",
      "item": [
        {
          "name": "Happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"ok shape\", () => { pm.expect(body).to.eql({ ok: true }); });",
                  "pm.test(\"json content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"ci-postman+{{$timestamp}}@example.com\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscribe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscribe"
              ]
            }
          }
        },
        {
          "name": "Invalid email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"error shape\", () => { pm.expect(body).to.have.property(\"error\", \"Invalid email\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"not-an-email\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscribe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscribe"
              ]
            }
          }
        },
        {
          "name": "Empty email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"error shape\", () => { pm.expect(body).to.have.property(\"error\", \"Invalid email\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscribe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscribe"
              ]
            }
          }
        },
        {
          "name": "Missing body (currently 500)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 500\", () => pm.response.to.have.status(500));",
                  "const body = pm.response.json();",
                  "pm.test(\"error shape\", () => { pm.expect(body).to.have.property(\"error\", \"Server error\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscribe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscribe"
              ]
            }
          }
        }
      ]
    },
